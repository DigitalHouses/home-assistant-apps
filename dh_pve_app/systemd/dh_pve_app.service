[Unit]
Description=DigitalHouses DH PVE MQTT Monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is intentional: SMART, /etc/pve guest configuration, passthrough
# inspection, and managed NUT policy operations require host-level access.
User=root
Group=root
WorkingDirectory=/opt/digitalhouses/dh_pve_app
ExecStart=/opt/digitalhouses/dh_pve_app/.venv/bin/python -m app.main --config /etc/dh_pve_app/dh_pve_app.conf --state-dir /var/lib/dh_pve_app
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# Keep the host filesystem protected; only NUT configuration is writable.
# The FSD helper is immutable application code under /opt; policy metadata
# remains app-owned state under /var/lib/dh_pve_app.
ReadWritePaths=/etc/nut

[Install]
WantedBy=multi-user.target
