[Unit]
Description=DigitalHouses PVE Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is intentional for host monitoring: SMART, /etc/pve guest configuration,
# passthrough inspection and other read-only host diagnostics require privileges.
User=root
Group=root
WorkingDirectory=/opt/digitalhouses/digitalhouses_pve_agent
ExecStartPre=/opt/digitalhouses/digitalhouses_pve_agent/.venv/bin/python -m app.ups_policy_state_migration --state-dir /var/lib/digitalhouses_pve_agent
ExecStart=/opt/digitalhouses/digitalhouses_pve_agent/.venv/bin/python -m app.main --config /etc/digitalhouses_pve_agent/digitalhouses_pve_agent.conf --state-dir /var/lib/digitalhouses_pve_agent
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# Runtime never modifies /etc/nut. ProtectSystem keeps system configuration
# read-only; application state under /var/lib/digitalhouses_pve_agent remains writable.

[Install]
WantedBy=multi-user.target
