[Unit]
Description=Recover interrupted DigitalHouses PVE Agent updates
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/digitalhouses-pve-agent-update-runner --recover
TimeoutStartSec=120
NoNewPrivileges=true
# Needs /etc, /opt, /root and /var/lib writes for restoring backup.
