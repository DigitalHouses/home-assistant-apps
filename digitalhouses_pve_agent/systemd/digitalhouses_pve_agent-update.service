[Unit]
Description=DigitalHouses PVE Agent independent update worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/digitalhouses_pve_agent/digitalhouses_pve_agent.conf

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/digitalhouses-pve-agent-update-runner
TimeoutStartSec=0
PrivateTmp=true
NoNewPrivileges=true
# The independent runner only updates the agent. The release installer may
# repair an obsolete local NUT netserver bind after an explicit UPS safety check.
# PVE and guest configuration are never changed.
