[general]
instance_id = plex
instance_name = DH Plex
poll_interval_seconds = 10
cpu_window_seconds = 60
log_level = info

[telemetry]
# Mandatory product telemetry. Fresh Linux Agent installations default to ON.
# Sends product, version and random installation ID (policy v2).
# Policy: https://github.com/DigitalHouses/home-assistant-apps/blob/main/docs/standards/PRODUCT_TELEMETRY_POLICY.md
# Explicit false stops the agent's normal runtime; telemetry network failure does not.
enabled = true
cpu_change_threshold = 5
high_load_threshold = 80
high_load_publish_interval_seconds = 60

[plex_api]
enabled = true
base_url = http://127.0.0.1:32400
token_file = /etc/digitalhouses_plex_agent/plex_local_admin_token
timeout_seconds = 3
library_refresh_seconds = 3600

[mqtt]
host =
port = 1883
username =
password =
topic_prefix = DigitalHouses/Global/digitalhouses_plex_agent
discovery_prefix = homeassistant
keepalive_seconds = 60
