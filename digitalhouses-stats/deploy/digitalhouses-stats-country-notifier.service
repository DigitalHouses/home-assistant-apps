[Unit]
Description=DigitalHouses Stats new-country MQTT notifier
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=digitalhouses-stats
Group=digitalhouses-stats
WorkingDirectory=/opt/digitalhouses/digitalhouses-stats
EnvironmentFile=/etc/digitalhouses-stats/digitalhouses-stats.env
EnvironmentFile=/etc/digitalhouses-stats/mqtt.env
ExecStart=/opt/digitalhouses/digitalhouses-stats/.venv/bin/python -m digitalhouses_stats.country_notifier
StateDirectory=digitalhouses-stats
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
