[Unit]
Description=DigitalHouses Stats local dashboard API
After=network-online.target postgresql.service digitalhouses-stats.service
Wants=network-online.target

[Service]
Type=simple
User=digitalhouses-stats
Group=digitalhouses-stats
WorkingDirectory=/opt/digitalhouses/digitalhouses-stats
EnvironmentFile=/etc/digitalhouses-stats/digitalhouses-stats.env
ExecStart=/opt/digitalhouses/digitalhouses-stats/.venv/bin/uvicorn digitalhouses_stats.dashboard_api:app --host 127.0.0.1 --port 8081 --no-access-log
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
